{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/keep-alive.js": { "includeFiles": "config.js" },
    "api/convert-ingredients.js": { "includeFiles": "config.js", "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/keep-alive", "schedule": "0 11 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
